# ── Server ────────────────────────────────────────────────────
PORT=5000
MONGO_URI=mongodb://localhost:27017/securestore
CLIENT_URL=http://localhost:3000

# ── Cloudinary (optional, for cloud storage) ──────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# OR set CLOUDINARY_URL=cloudinary://1234567890:secret@cloudname

# ── Developer Console ─────────────────────────────────────────
# Change these before going to production!
DEV_PASSWORD=dev123
DEV_SECRET=securestore-dev-secret-change-me